/* SP Flash Tool - Modern Flat Theme
 * Fusion-based with clean dark titlebar and light content areas.
 */

/* ── Global ─────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Noto Sans", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #f5f5f5;
}

QWidget {
    color: #1e1e1e;
}

/* ── Tab Widget ─────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #e8e8e8;
    border: 1px solid #c0c0c0;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 7px 18px;
    margin-right: 2px;
    color: #555555;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1a73e8;
    font-weight: 600;
    border-bottom: 2px solid #1a73e8;
}

QTabBar::tab:hover:!selected {
    background: #dce8f8;
    color: #333333;
}

/* ── Push Buttons ───────────────────────────────────────────── */
QPushButton {
    background-color: #1a73e8;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 7px 20px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1558b0;
}

QPushButton:pressed {
    background-color: #0d47a1;
}

QPushButton:disabled {
    background-color: #b0bec5;
    color: #78909c;
}

QPushButton:flat {
    background-color: transparent;
    border: 1px solid #c0c0c0;
    color: #555555;
}

QPushButton:flat:hover {
    background-color: #e3f2fd;
    border: 1px solid #1a73e8;
    color: #1a73e8;
}

/* ── Tool Buttons ───────────────────────────────────────────── */
QToolButton {
    background-color: #e8e8e8;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 10px;
}

QToolButton:hover {
    background-color: #dce8f8;
    border: 1px solid #1a73e8;
}

QToolButton:pressed {
    background-color: #c5d9f2;
}

/* ── Combo Box ──────────────────────────────────────────────── */
QComboBox {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 10px;
    background: white;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #1a73e8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border-left: 1px solid #c0c0c0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: #f0f0f0;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #666666;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    border: 1px solid #c0c0c0;
    background: white;
    selection-background-color: #1a73e8;
    selection-color: white;
    outline: none;
}

/* ── Line Edit / Text Edit / Spin Box ───────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px 8px;
    background: white;
    selection-background-color: #1a73e8;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1a73e8;
}

/* ── Check Box / Radio Button ───────────────────────────────── */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox {
    spacing: 8px;
}

QRadioButton {
    spacing: 8px;
}

/* ── Group Box ──────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 8px 8px 8px;
    font-weight: 600;
    color: #333333;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background: #f5f5f5;
}

/* ── Table / Tree / List ────────────────────────────────────── */
QTableView, QTreeView, QListView {
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background: white;
    alternate-background-color: #f8f9fa;
    gridline-color: #e8e8e8;
    selection-background-color: #1a73e8;
    selection-color: white;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 4px 8px;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background: #1a73e8;
    color: white;
}

QHeaderView::section {
    background-color: #f0f0f0;
    border: none;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;
    padding: 6px 8px;
    font-weight: 600;
    color: #555555;
}

QHeaderView::section:hover {
    background-color: #e3f2fd;
}

/* ── Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #e0e0e0;
    text-align: center;
    color: #555555;
    font-weight: 600;
    min-height: 18px;
    max-height: 18px;
}

QProgressBar::chunk {
    border-radius: 4px;
    background-color: #1a73e8;
}

/* ── Scroll Bar ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c0c0c0;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── Menu Bar ───────────────────────────────────────────────── */
QMenuBar {
    background: #f5f5f5;
    border-bottom: 1px solid #d0d0d0;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #dce8f8;
    color: #1a73e8;
}

/* ── Menu ───────────────────────────────────────────────────── */
QMenu {
    background: white;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
}

QMenu::item:selected {
    background: #1a73e8;
    color: white;
    border-radius: 4px;
    margin: 0 4px;
}

QMenu::separator {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 8px;
}

/* ── Status Bar ─────────────────────────────────────────────── */
QStatusBar {
    background: #f0f0f0;
    border-top: 1px solid #d0d0d0;
    color: #555555;
}

/* ── Tool Box (left panel) ──────────────────────────────────── */
QToolBox::tab {
    background: #e8e8e8;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: 600;
    color: #555555;
}

QToolBox::tab:selected {
    background: #dce8f8;
    color: #1a73e8;
    border: 1px solid #1a73e8;
}

/* ── Tool Tip ───────────────────────────────────────────────── */
QToolTip {
    background: #333333;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Splitter ───────────────────────────────────────────────── */
QSplitter::handle {
    background: #e0e0e0;
}

QSplitter::handle:hover {
    background: #1a73e8;
}

/* ── Frame ──────────────────────────────────────────────────── */
QFrame[frameShape="4"] { /* HLine */
    background: #d0d0d0;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background: #d0d0d0;
    max-width: 1px;
}
