/* SP Flash Tool - Dark Mode Theme */

* {
    font-family: "Segoe UI", "Noto Sans", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

QWidget {
    color: #d4d4d4;
}

/* ── Tab Widget ─────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background: #252526;
    top: -1px;
}

QTabBar::tab {
    background: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 7px 18px;
    margin-right: 2px;
    color: #969696;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: #252526;
    color: #4fc3f7;
    font-weight: 600;
    border-bottom: 2px solid #4fc3f7;
}

QTabBar::tab:hover:!selected {
    background: #333333;
    color: #d4d4d4;
}

/* ── Push Buttons ───────────────────────────────────────────── */
QPushButton {
    background-color: #0e639c;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 7px 20px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #0d5490;
}

QPushButton:disabled {
    background-color: #3c3c3c;
    color: #666666;
}

QPushButton:flat {
    background-color: transparent;
    border: 1px solid #3c3c3c;
    color: #969696;
}

QPushButton:flat:hover {
    background-color: #264f78;
    border: 1px solid #4fc3f7;
    color: #4fc3f7;
}

/* ── Tool Buttons ───────────────────────────────────────────── */
QToolButton {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 5px 10px;
    color: #d4d4d4;
}

QToolButton:hover {
    background-color: #333333;
    border: 1px solid #4fc3f7;
}

QToolButton:pressed {
    background-color: #264f78;
}

/* ── Combo Box ──────────────────────────────────────────────── */
QComboBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 5px 10px;
    background: #3c3c3c;
    color: #d4d4d4;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #4fc3f7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border-left: 1px solid #555555;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: #3c3c3c;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #969696;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    border: 1px solid #3c3c3c;
    background: #2d2d2d;
    color: #d4d4d4;
    selection-background-color: #094771;
    selection-color: white;
    outline: none;
}

/* ── Line Edit / Text Edit / Spin Box ───────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 5px 8px;
    background: #3c3c3c;
    color: #d4d4d4;
    selection-background-color: #264f78;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #007acc;
}

/* ── Check Box ──────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #d4d4d4;
}

/* ── Radio Button ───────────────────────────────────────────── */
QRadioButton {
    spacing: 8px;
    color: #d4d4d4;
}

/* ── Group Box ──────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 8px 8px 8px;
    font-weight: 600;
    color: #d4d4d4;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background: #1e1e1e;
}

/* ── Table / Tree / List ────────────────────────────────────── */
QTableView, QTreeView, QListView {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background: #1e1e1e;
    alternate-background-color: #252526;
    gridline-color: #333333;
    color: #d4d4d4;
    selection-background-color: #094771;
    selection-color: white;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 4px 8px;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background: #094771;
    color: white;
}

QHeaderView::section {
    background-color: #37373d;
    border: none;
    border-right: 1px solid #4a4a4a;
    border-bottom: 2px solid #007acc;
    padding: 8px 10px;
    font-weight: 600;
    color: #cccccc;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: #45454d;
    color: #ffffff;
}

QHeaderView::section:pressed {
    background-color: #094771;
    color: #ffffff;
}

QHeaderView::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QHeaderView::up-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* ── Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #3c3c3c;
    text-align: center;
    color: #d4d4d4;
    font-weight: 600;
    min-height: 18px;
    max-height: 18px;
}

QProgressBar::chunk {
    border-radius: 4px;
    background-color: #0e639c;
}

/* ── Scroll Bar ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #424242;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #555555;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── Menu Bar ───────────────────────────────────────────────── */
QMenuBar {
    background: #252526;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px 0;
    color: #d4d4d4;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #094771;
    color: white;
}

/* ── Menu ───────────────────────────────────────────────────── */
QMenu {
    background: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 4px 0;
    color: #d4d4d4;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
}

QMenu::item:selected {
    background: #094771;
    color: white;
    border-radius: 4px;
    margin: 0 4px;
}

QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 8px;
}

/* ── Status Bar ─────────────────────────────────────────────── */
QStatusBar {
    background: #007acc;
    border-top: none;
    color: white;
}

/* ── Tool Box (left panel) ──────────────────────────────────── */
QToolBox::tab {
    background: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: 600;
    color: #969696;
}

QToolBox::tab:selected {
    background: #094771;
    color: white;
    border: 1px solid #4fc3f7;
}

/* ── Tool Tip ───────────────────────────────────────────────── */
QToolTip {
    background: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Splitter ───────────────────────────────────────────────── */
QSplitter::handle {
    background: #3c3c3c;
}

QSplitter::handle:hover {
    background: #4fc3f7;
}

/* ── Text Browser ───────────────────────────────────────────── */
QTextBrowser {
    background: transparent;
    color: #d4d4d4;
    border: none;
}

QTextBrowser a {
    color: #4fc3f7;
}

QTextBrowser a:hover {
    color: #81d4fa;
}

/* ── Frame ──────────────────────────────────────────────────── */
QFrame[frameShape="4"] { /* HLine */
    background: #3c3c3c;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background: #3c3c3c;
    max-width: 1px;
}
